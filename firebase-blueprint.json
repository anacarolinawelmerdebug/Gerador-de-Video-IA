{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Video project created by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "style": { "type": "string" },
        "aspectRatio": { "type": "string" },
        "fps": { "type": "number" },
        "resolution": { "type": "string" },
        "soundtrack": { "type": "string" },
        "customAudioUrl": { "type": "string" },
        "customAudioTitle": { "type": "string" },
        "enableVoiceover": { "type": "boolean" },
        "voiceGender": { "type": "string" },
        "scenes": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "scenes", "createdAt", "updatedAt"]
    },
    "MusicTrack": {
      "title": "MusicTrack",
      "description": "Generated AI Music Track",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "prompt": { "type": "string" },
        "genre": { "type": "string" },
        "tempo": { "type": "string" },
        "duration": { "type": "number" },
        "audioUrl": { "type": "string" },
        "mimeType": { "type": "string" },
        "lyrics": { "type": "string" },
        "model": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "audioUrl", "createdAt"]
    },
    "VoiceTrack": {
      "title": "VoiceTrack",
      "description": "Generated AI Voice Track",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "text": { "type": "string" },
        "voiceName": { "type": "string" },
        "language": { "type": "string" },
        "speed": { "type": "number" },
        "pitch": { "type": "number" },
        "emotion": { "type": "string" },
        "audioUrl": { "type": "string" },
        "source": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "text", "voiceName", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "entity": "User",
      "schema": "#/entities/User",
      "description": "User profile data"
    },
    "/users/{userId}/projects/{projectId}": {
      "entity": "Project",
      "schema": "#/entities/Project",
      "description": "Video projects belonging to the user"
    },
    "/users/{userId}/musicTracks/{trackId}": {
      "entity": "MusicTrack",
      "schema": "#/entities/MusicTrack",
      "description": "AI music tracks generated by the user"
    },
    "/users/{userId}/voiceTracks/{voiceId}": {
      "entity": "VoiceTrack",
      "schema": "#/entities/VoiceTrack",
      "description": "AI voice tracks generated by the user"
    }
  }
}
